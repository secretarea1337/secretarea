rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Base authentication check
    function isSignedIn() {
      return request.auth != null;
    }

    // Single document fetch helper for user profile
    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Root admin email check to bootstrap and guarantee permissions for primary administrator.
    // Strictly requires email_verified == true to prevent account spoofing / impersonation!
    function isRootAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email.lower() == 'secretarea1337@gmail.com' ||
         request.auth.token.email.lower() == 'marouananouar02@gmail.com');
    }

    // Role-based admin check: supports root verified admin emails and users/{uid}.role
    function isAdmin() {
      return isRootAdminEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUser(request.auth.uid).role in ['admin', 'Admin']
      );
    }

    // Check if target user document has an Admin role
    function isDocAdmin(data) {
      return 'role' in data && data.role in ['admin', 'Admin'];
    }

    // Check if user is permanently blacklisted (manual flag, status, or >= 3 blocks)
    function isBlacklisted(data) {
      return data.isBlacklisted == true ||
             data.status == 'blacklisted' ||
             (data.blockCount != null && data.blockCount >= 3);
    }

    // Check if user has active restrictions (blocked or blacklisted)
    function isRestricted(data) {
      return data.isBlocked == true ||
             data.status == 'blocked' ||
             isBlacklisted(data);
    }

    // Single-lookup check for non-user collections: verifies user exists and has no restrictions
    function isCallerActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        !isRestricted(getUser(request.auth.uid));
    }

    // Users collection:
    // - Blacklisted users (or >= 3 blocks): NO read or write access
    // - Blocked users: read-only access to own profile (get); cannot update
    // - Active users: full access to own profile; STRICTLY CANNOT self-assign admin role or tamper with moderation flags
    // - Admins: full management; cannot demote existing admins
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId
          ? !isBlacklisted(resource.data)
          : isAdmin()
      );

      allow list: if isAdmin();

      allow create: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role in ['user', 'User']) &&
          (!('isBlacklisted' in request.resource.data) || request.resource.data.isBlacklisted == false) &&
          (!('isBlocked' in request.resource.data) || request.resource.data.isBlocked == false) &&
          (!('blockCount' in request.resource.data) || request.resource.data.blockCount == 0)
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ? (
          !isDocAdmin(resource.data) || request.auth.uid == userId || request.resource.data.role in ['admin', 'Admin']
        ) : (
          request.auth.uid == userId &&
          !isRestricted(resource.data) &&
          // Non-admins can NEVER touch the role field or moderation flags (prevents privilege escalation)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isBlocked', 'isBlacklisted', 'status', 'blockCount', 'blockedUntil', 'blockedAt', 'blacklistedAt'
          ])
        )
      );

      allow delete: if isAdmin() && !isDocAdmin(resource.data);

      // User subcollections: admin or active non-restricted owner
      match /{allPaths=**} {
        allow read, write: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == userId &&
          isCallerActive()
        );
      }
    }

    // System collection (Global Banner, System Config, Admin Profile):
    // Publicly readable, admin writable
    match /system/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Banned Identifiers: Admin only
    match /banned_identifiers/{docId} {
      allow read, write: if isAdmin();
    }

    // Requests collection:
    // Blocked and blacklisted users cannot read, list, or submit requests
    match /requests/{requestId} {
      allow create: if isCallerActive() && request.resource.data.userId == request.auth.uid;
      allow get, update, delete: if isAdmin() || (isCallerActive() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isCallerActive();
    }

    // Banned Devices collection:
    // - Device lookup allowed by exact fingerprint for device status verification
    // - Listing all banned devices, creation, updates, and deletes are strictly Admin only
    match /bannedDevices/{deviceId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Global Settings: Publicly readable, admin writable
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Removed / Banned User Audit Logs: Admin only access
    match /removedUsers/{docId} {
      allow read, write: if isAdmin();
    }

    // LiveMovement: Admin only
    match /liveMovement/{docId} {
      allow read, write: if isAdmin();
      match /{allPaths=**} {
        allow read, write: if isAdmin();
      }
    }

    // Diagnostics: Disabled
    match /diagnostics/{diagnosticId} {
      allow read, write: if false;
    }

    // Reports collection:
    // - Broken link reports can be submitted by visitors
    // - Non-admins can ONLY submit reports with 'pending' status and cannot inject resolution metadata
    // - Listing reports is restricted to Admins to prevent scraping user emails and PII
    // - Individual report get is allowed for Admins or the original reporter
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['itemId', 'itemName', 'reason', 'status']) &&
                       request.resource.data.itemId is string &&
                       request.resource.data.itemName is string &&
                       request.resource.data.reason is string &&
                       (isAdmin() || (
                         request.resource.data.status == 'pending' &&
                         (!('fixedAt' in request.resource.data) || request.resource.data.fixedAt == null) &&
                         (!('fixedBy' in request.resource.data) || request.resource.data.fixedBy == null) &&
                         (!('fixedNotes' in request.resource.data) || request.resource.data.fixedNotes == null) &&
                         (!('fixedLinks' in request.resource.data) || request.resource.data.fixedLinks == null)
                       ));
      allow get: if isAdmin() || (isSignedIn() && resource.data.reportedBy.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Item Fixes collection:
    // - Publicly readable so all users and guests receive fixed links
    // - Writable by Admin only
    match /item_fixes/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

  }
}
